{
  "name": "professor-research-career-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 0.0.0.0",
    "lint": "eslint frontend --ignore-pattern dist",
    "data:build": "python3 backend/scripts/build_release.py",
    "data:validate": "python3 backend/scripts/validate_release.py"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.0.13"
  },
  "type": "module"
}
